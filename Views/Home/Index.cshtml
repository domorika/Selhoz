@model IEnumerable<Selhoz.Models.NotificationViewModel>
@{
    ViewData["Title"] = "Главная панель";
}

<h2 class="mb-4">Панель уведомлений</h2>

<table class="table table-hover">
    <thead class="table-success">
        <tr>
            <th>Тип</th>
            <th>Описание</th>
            <th>Статус</th>
            <th>Дата</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr class="@(item.IsCritical ? "table-danger" : "")">
                <td><span class="badge @item.BadgeClass">@item.Type</span></td>
                <td>@item.Description</td>
                <td><strong>@item.StatusText</strong></td>
                <td>@item.CreationDate.ToShortDateString()</td>
            </tr>
        }
    </tbody>
</table>

<a href="/Plants" class="btn btn-success me-2">Справочники → Культуры</a>
<a href="/Workers" class="btn btn-success">Сотрудники</a>