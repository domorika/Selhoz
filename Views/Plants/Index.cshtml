@model IEnumerable<Selhoz.Models.Plant>
@{
    ViewData["Title"] = "Справочник культур";
}

<div class="mb-4">
    <h4 style="font-family: Verdana; font-weight: bold;">🌱 Справочник сельскохозяйственных культур</h4>
</div>

<div class="table-responsive shadow-sm rounded mb-4">
    <table class="table table-striped table-hover bg-white m-0" style="font-family: Verdana;">
        <thead class="table-success">
            <tr>
                <th>ID</th>
                <th>Название культуры</th>
                <th>Тип</th>
                <th>Период роста (дней)</th>
                <th>Потребность в воде</th>
                <th>Климатическая зона</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var plant in Model)
            {
                <tr>
                    <td>@plant.Id</td>
                    <td>@plant.Name</td>
                    <td>@plant.Type</td>
                    <td>@plant.GrowthPeriodDays</td>
                    <td>@plant.WaterRequirements</td>
                    <td>@plant.ClimateRequirements</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="d-flex justify-content-end mb-5">
    @if (User.IsInRole("Agronom") || User.IsInRole("Director"))
    {
        <a asp-action="Create" class="btn btn-success" style="font-family: Verdana; font-size: 12pt; padding: 8px 20px;">+ Добавить культуру</a>
    }
</div>