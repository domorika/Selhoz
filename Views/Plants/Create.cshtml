@model Selhoz.Models.Plant
@{
    ViewData["Title"] = "Добавить культуру";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="card shadow border-0">
            <div class="card-header bg-success text-white">
                <h4 class="mb-0">Регистрация новой культуры</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Название культуры</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Type" class="form-label">Тип (класс)</label>
                        <input asp-for="Type" class="form-control" placeholder="Зерновые, масличные, бобовые..." />
                        <span asp-validation-for="Type" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="GrowthPeriodDays" class="form-label">Период роста (дней)</label>
                        <input asp-for="GrowthPeriodDays" class="form-control" type="number" />
                        <span asp-validation-for="GrowthPeriodDays" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="WaterRequirements" class="form-label">Потребность в воде</label>
                        <input asp-for="WaterRequirements" class="form-control" placeholder="Высокая, средняя, низкая" />
                        <span asp-validation-for="WaterRequirements" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ClimateRequirements" class="form-label">Климатические условия</label>
                        <input asp-for="ClimateRequirements" class="form-control" placeholder="Умеренный, теплолюбивая..." />
                        <span asp-validation-for="ClimateRequirements" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">Назад к списку</a>
                        <button type="submit" class="btn btn-success">Добавить культуру</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>