@model IEnumerable<Selhoz.Models.Worker>
@{
    ViewData["Title"] = "Справочник сотрудников";
}

<h2 class="mb-4">👷 Сотрудники предприятия</h2>

<table class="table table-striped table-hover">
    <thead class="table-success">
        <tr>
            <th>ID</th>
            <th>ФИО</th>
            <th>Должность</th>
            <th>Телефон</th>
            <th>Квалификация</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var worker in Model)
        {
            <tr>
                <td>@worker.Id</td>
                <td>@worker.FullName</td>
                <td>@worker.Position</td>
                <td>@worker.Phone</td>
                <td>@worker.Education</td>
            </tr>
        }
    </tbody>
</table>
<br />
<div class="d-flex justify-content-end mb-5">
    @if (User.IsInRole("Agronom") || User.IsInRole("Director"))
    {
        <a asp-action="Create" class="btn btn-success" style="font-family: Verdana; font-size: 12pt; padding: 8px 20px;">+ Добавить поле</a>
    }
</div>